# Variables que docker-compose sustituye en build.args del frontend (Next.js las
# inyecta en el bundle del navegador en BUILD time). No son secretas: la anon key
# de Supabase está diseñada para exponerse en el cliente.
#
# Los secretos reales del backend (DATABASE_URL, SUPABASE_KEY, etc.) NO van aquí -
# viven en backend/.env (ver backend/.env.example).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
