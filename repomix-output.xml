    outline: none !important;
    min-width: 140px; /* Para que tengan buen tamaño */
}

/* 1. Botón "Enviar enlace" (Igual al botón Entrar) */
.btn-pro-confirm {
    background-color: var(--dark-green) !important; /* El color oscuro elegante */
    color: white !important;
    background-image: none !important; /* Adiós gradiente */
    box-shadow: 0 10px 20px rgba(3, 34, 33, 0.3) !important;
