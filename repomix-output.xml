export const eliminarDeStaging = async (tempId) => {
    const item = state.stagedFiles.find(f => f.id_temp == tempId);
    if (!item) return;

    const result = await Swal.fire({
        title: '¿Quitar de la lista?',
        text: `Vas a quitar "${item.title}" de la carga actual.`,
