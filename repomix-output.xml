.custom-file-upload:hover { border-color: var(--accent); background: rgba(44, 194, 149, 0.05); color: #fff; }
.custom-file-upload i { font-size: 32px; margin-bottom: 10px; color: #555; transition: color 0.3s; }
.custom-file-upload:hover i { color: var(--accent); transform: translateY(-3px); }

.file-count { margin-top: 10px; background: var(--accent); color: #000; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; }
.file-list-area {
    margin-bottom: 15px;
    max-height: 500px;
