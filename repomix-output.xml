/* css/admin/music-manager.css */

.manager-header {
    display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;
}
.manager-header h2 { font-size: 22px; color: #fff; margin: 0; }

/* Pestañas */
.tabs {
    background: #111; padding: 5px; border-radius: 12px; display: flex; gap: 8px; border: 1px solid var(--glass-border);
}
.tab-btn {
    background: transparent; border: none; color: var(--text-muted); padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500; transition: all 0.3s ease;
}
.tab-btn:hover { color: #fff; background: rgba(255,255,255,0.05); }
.tab-btn.active { background: var(--accent); color: #000; font-weight: 700; box-shadow: 0 4px 15px rgba(44, 194, 149, 0.3); }

/* Paneles y Layout */
.glass-panel {
    background: rgba(20, 20, 20, 0.6); border: 1px solid var(--glass-border); backdrop-filter: blur(10px); padding: 30px; border-radius: 16px; margin-bottom: 25px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}
.glass-panel h3 { margin-top: 0; margin-bottom: 10px; color: var(--accent); display: flex; align-items: center; gap: 10px; }
.glass-panel p { color: var(--text-muted); font-size: 14px; margin-bottom: 20px; }

.grid-2-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
.input-group-row { display: flex; gap: 15px; margin-top: 15px; }

/* Inputs y Botones Generales */
form label { display: block; margin-bottom: 8px; color: #bbb; font-size: 13px; font-weight: 500; }

input[type="text"], input[type="file"] {
    width: 100%; background: #0a0a0a; border: 1px solid #333; padding: 14px; border-radius: 10px; color: #fff; outline: none; margin-bottom: 20px; transition: all 0.3s ease; font-size: 14px;
}
input[type="text"]:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(44, 194, 149, 0.1); }

.btn-primary {
    background: var(--accent); color: #000; border: none; padding: 14px 25px; border-radius: 10px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: transform 0.2s, box-shadow 0.2s; width: auto;
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(44, 194, 149, 0.4); }

.btn-secondary {
    background: rgba(255, 255, 255, 0.1); color: #fff; border: 1px solid rgba(255, 255, 255, 0.1); padding: 14px; border-radius: 10px; cursor: pointer; width: 100%; font-weight: 600; transition: all 0.3s;
}
.btn-secondary:hover { background: rgba(255, 255, 255, 0.2); border-color: #fff; }
.full-width { width: 100%; }

/* Uploaders Personalizados (Música y Portada) */
.file-upload-wrapper { position: relative; margin-bottom: 20px; }

.custom-file-upload {
