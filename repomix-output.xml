      <button 
        onClick={handleLogout}
        className="btn-login" 
        style={{ maxWidth: '200px', margin: '0 auto', backgroundColor: '#e74c3c' }}
      >
        <i className="bi bi-box-arrow-left" style={{ marginRight: '10px' }}></i>
        Cerrar Sesión
      </button>
    </div>
  );
}
