generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model User {
  uid              String             @id @db.Uuid
  nombre           String?
  apellidoPaterno  String?            @map("apellido_paterno")
  apellidoMaterno  String?            @map("apellido_materno")
  correo           String?            @unique
  fechaNacimiento  DateTime?          @map("fecha_de_nacimiento") @db.Date
  rol              String?            @default("user")
  createdAt        DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  cancionesMeGusta CancionesMeGusta[]
  playlists        Playlist[]
  users            users              @relation(fields: [uid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("usuarios")
  @@schema("public")
}

model Cancion {
  idCancion          BigInt             @id @default(autoincrement()) @map("id_cancion")
  tituloCancion      String             @map("titulo_cancion")
  artistaId          BigInt             @map("artista_id")
  albumId            BigInt?            @map("album_id")
  imagenUrl          String?            @map("imagen_url")
  duracionCancion    Float?             @map("duracion_cancion")
  reproducciones     Int                @default(0)
  audioPath          String?            @map("audio_path")
  numeroTrack        Int?               @default(0) @map("numero_track")
  album              album?             @relation(fields: [albumId], references: [id_album])
  artista            artista            @relation(fields: [artistaId], references: [id_artista], onDelete: Cascade)
  canciones_me_gusta CancionesMeGusta[]
  playlist_usuario   playlist_usuario[]

  @@index([artistaId], map: "idx_canciones_artista")
  @@index([reproducciones(sort: Desc)], map: "idx_canciones_reproducciones")
  @@map("canciones")
  @@schema("public")
}

model CancionesMeGusta {
  uid       String   @db.Uuid
  idCancion BigInt   @map("id_cancion")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  canciones Cancion  @relation(fields: [idCancion], references: [idCancion], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)

  @@id([uid, idCancion])
  @@index([idCancion], map: "idx_megusta_cancion")
  @@map("canciones_me_gusta")
  @@schema("public")
}

model Playlist {
  idPlaylist       BigInt             @id @default(autoincrement()) @map("id_playlist")
  uid              String             @db.Uuid
  tituloPlaylist   String             @map("titulo_playlist")
  descripcion      String?
  imagen_url       String?
  duracion         Float?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  user             User               @relation(fields: [uid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  playlist_usuario playlist_usuario[]

  @@unique([idPlaylist, uid], map: "uq_playlist_owner")
  @@map("playlist")
  @@schema("public")
}

