<file path="www/css/styleInicioSesion.css">
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

/* --- PALETA AXIFORMA --- */
:root {
  --rich-black: #000F01;       
  --dark-green: #032221;       
  --bangladesh-green: #03624C; 
  --mountain-meadow: #2CC295;  
  --anti-flash-white: #F1F7F6; 
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  background-color: var(--rich-black);
  background-image: radial-gradient(circle at center, #062b25 0%, #000F01 70%);
  
  /* Usamos min-height para asegurar que cubra todo */
  min-height: 100vh;
  width: 100%;
  
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* Agregamos padding al body para que en celulares no toque los bordes */
  padding: 20px; 
  overflow: hidden; 
}

/* --- LA CAJA BLANCA (Compacta) --- */
.login-card {
  background-color: #FFFFFF;
  width: 100%;
  max-width: 380px; /* Ancho ideal */
  
  /* RESPONSIVIDAD VERTICAL: */
  /* 1. Reducimos el padding vertical (antes 50px, ahora 35px) */
  padding: 35px 30px; 
  /* 2. Nunca ocupes más del 90% de la altura de la pantalla */
  max-height: 90vh; 
  /* 3. Si no cabe, permite scroll interno suave */
  overflow-y: auto; 
  
  border-radius: 30px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  position: relative;

  /* Ocultar barra de scroll fea (Chrome/Safari/Opera) */
  scrollbar-width: none; 
}

.login-card::-webkit-scrollbar {
  display: none;
}

/* --- TEXTOS --- */
.header-text h1 {
  font-size: 26px; /* Un pelín más chico para ahorrar espacio */
  font-weight: 700;
  color: var(--dark-green);
  margin-bottom: 5px;
  text-align: center;
}

.header-text p {
  font-size: 13px;
  color: #6c7c79;
  margin-bottom: 25px; /* Menos margen */
  font-weight: 400;
  text-align: center;
}

.header-text a {
  color: var(--bangladesh-green);
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s;
}

.header-text a:hover {
  color: var(--mountain-meadow);
  text-decoration: underline;
}

/* --- INPUTS --- */
.input-group {
  position: relative;
  margin-bottom: 15px; /* Más juntitos */
}

.input-group input {
  width: 100%;
  background-color: var(--anti-flash-white);
  border: 1px solid transparent;
  /* Reducimos el padding del input para que no sea tan alto */
  padding: 14px 20px; 
  border-radius: 14px;
  font-size: 14px;
  color: var(--dark-green);
  outline: none;
  transition: all 0.3s ease;
  font-weight: 500;
}

.input-group input::placeholder {
  color: #9aa8a5;
}

.input-group input:focus {
  background-color: #fff;
  border-color: var(--mountain-meadow);
  box-shadow: 0 0 0 4px rgba(44, 194, 149, 0.15);
}

.toggle-password {
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  color: #9aa8a5;
  cursor: pointer;
  transition: 0.3s;
}

.toggle-password:hover {
  color: var(--bangladesh-green);
}

.forgot-link {
  text-align: right;
  margin-bottom: 20px; /* Menos margen */
  margin-top: -5px;
}

.forgot-link a {
  font-size: 12px;
  color: #6c7c79;
  text-decoration: none;
  font-weight: 500;
  transition: 0.3s;
}

.forgot-link a:hover {
  color: var(--bangladesh-green);
}

/* --- BOTÓN PRINCIPAL --- */
.btn-login {
  width: 100%;
  background-color: var(--dark-green);
  color: #fff;
  border: none;
  padding: 14px; /* Un poco menos alto */
  border-radius: 50px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10px 20px rgba(3, 34, 33, 0.2);
}

.btn-login:hover {
  background-color: var(--bangladesh-green);
  transform: translateY(-2px);
  box-shadow: 0 15px 30px rgba(3, 98, 76, 0.3);
}

/* --- DIVIDER --- */
.divider {
  display: flex;
  align-items: center;
  margin: 20px 0; /* Más compacto */
}

.divider::before, .divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background-color: #e1e8e6;
}

.divider span {
  padding: 0 10px;
  color: #9aa8a5;
  font-size: 11px;
  font-weight: 500;
}

/* --- BOTÓN GOOGLE --- */
.social-row {
  display: flex;
  justify-content: center;
}

.social-btn.google {
  width: 100%;
  padding: 12px; /* Más compacto */
  border-radius: 50px;
  background-color: #fff;
  border: 1px solid #e1e8e6;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  cursor: pointer;
  transition: 0.3s;
  text-decoration: none;
  color: var(--dark-green);
}

.social-btn.google span {
  font-weight: 600;
  font-size: 14px;
}

.social-btn.google:hover {
  background-color: #f8fcfb;
  border-color: #d1dcd9;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(0,0,0,0.05);
}

.social-btn img {
  width: 20px !important;
  height: 20px !important;
}

/* Footer */
.footer-terms {
  text-align: center;
  font-size: 10px;
  color: #9aa8a5;
  line-height: 1.5;
  margin-top: 25px; /* Menos espacio final */
}

.footer-terms a {
  color: var(--bangladesh-green);
  text-decoration: none;
  font-weight: 600;
}

.footer-terms a:hover {
  text-decoration: underline;
}

/* =========================================
   SWEETALERT PRO DESIGN
   ========================================= */

/* La tarjeta principal del pop-up */
.swal-popup-pro {
    border-radius: 30px !important; /* Muy redondeado */
    padding: 30px !important;
    box-shadow: 0 30px 70px rgba(0, 15, 1, 0.5) !important; /* Sombra profunda */
    font-family: 'Poppins', sans-serif !important; /* Tu fuente */
    border: 1px solid rgba(255,255,255,0.1); /* Borde sutil */
}

/* Títulos y Texto */
.swal-title-pro {
    font-weight: 700;
    color: var(--dark-green); /* Usa tus variables de color */
    font-size: 24px;
    display: block;
    margin-bottom: 10px;
}

.swal-text-pro {
    color: #6c7c79;
    font-size: 14px;
    line-height: 1.5;
}

/* El campo de input (estilo White Card) */
.swal-input-pro {
    height: 50px !important;
