<file path="www/css/pantallaPrincipal/topBar-artistas-generos.css">
/* =========================================================
   topbar.css
   TOPBAR + GRID + ARTISTAS + GENEROS (FULL FIX)
   ========================================================= */

/* ✅ Anula el body flex del styles.css SOLO en esta vista */
body.app-body{
  display:block !important;
  align-items:initial !important;
  justify-content:initial !important;
  min-height:100vh;
  margin:0;
}

/* ✅ Forzar color blanco en toda la vista (excepto cards blancas) */
body.app-body,
body.app-body *{
  color: #fff;
}

/* wrapper */
body.app-body .app{
  width:min(1240px, 100%);
  margin:0 auto;
  padding:14px 14px 0;
  min-height:100vh;
}

/* TOPBAR */
body.app-body .topbar{
  position:relative;
  z-index:10;

  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;

  padding:12px 14px;
  border-radius:999px;
  margin-top:12px;

