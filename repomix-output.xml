<file path="frontend/src/styles/auth.css">
/* --- LA CAJA BLANCA (Login) --- */
.login-card {
  background-color: #FFFFFF;
  width: 100%;
  max-width: 380px; 
  padding: 35px 30px; 
  max-height: 90vh; 
  overflow-y: auto; 
  border-radius: 30px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  position: relative;
  scrollbar-width: none; 
}
.login-card::-webkit-scrollbar { display: none; }

/* --- TEXTOS --- */
.header-text h1, .header-text h2 {
  font-size: 26px; 
  font-weight: 700;
  color: var(--dark-green);
  margin-bottom: 5px;
  text-align: center;
}
.header-text p {
  font-size: 13px;
  color: #6c7c79;
  margin-bottom: 25px; 
  font-weight: 400;
  text-align: center;
}
.header-text a {
  color: var(--bangladesh-green);
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s;
}
.header-text a:hover { color: var(--mountain-meadow); text-decoration: underline; }

/* --- INPUTS --- */
.input-group { position: relative; margin-bottom: 15px; }
.input-group input {
  width: 100%;
  background-color: var(--anti-flash-white);
  border: 1px solid transparent;
  padding: 14px 20px; 
  border-radius: 14px;
  font-size: 14px;
  color: var(--dark-green);
  outline: none;
  transition: all 0.3s ease;
  font-weight: 500;
}
.input-group input::placeholder { color: #9aa8a5; }
.input-group input:focus {
  background-color: #fff;
  border-color: var(--mountain-meadow);
  box-shadow: 0 0 0 4px rgba(44, 194, 149, 0.15);
}

.toggle-password {
  position: absolute;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  color: #9aa8a5;
  cursor: pointer;
  transition: 0.3s;
}
.toggle-password:hover { color: var(--bangladesh-green); }

.forgot-link { text-align: right; margin-bottom: 20px; margin-top: -5px; }
.forgot-link a { font-size: 12px; color: #6c7c79; text-decoration: none; font-weight: 500; transition: 0.3s; }
.forgot-link a:hover { color: var(--bangladesh-green); }

/* --- BOTONES --- */
.btn-login, .btn-register {
  width: 100%;
  background-color: var(--dark-green);
  color: #fff;
  border: none;
  padding: 14px; 
  border-radius: 50px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10px 20px rgba(3, 34, 33, 0.2);
}
.btn-login:hover, .btn-register:hover {
  background-color: var(--bangladesh-green);
  transform: translateY(-2px);
  box-shadow: 0 15px 30px rgba(3, 98, 76, 0.3);
}

/* --- DIVIDER Y GOOGLE --- */
.divider { display: flex; align-items: center; margin: 20px 0; }
.divider::before, .divider::after { content: ""; flex: 1; height: 1px; background-color: #e1e8e6; }
.divider span { padding: 0 10px; color: #9aa8a5; font-size: 11px; font-weight: 500; }

.social-row { display: flex; justify-content: center; }
.social-btn.google {
  width: 100%; padding: 12px; border-radius: 50px; background-color: #fff;
  border: 1px solid #e1e8e6; display: flex; align-items: center; justify-content: center;
  gap: 10px; cursor: pointer; transition: 0.3s; text-decoration: none; color: var(--dark-green);
}
.social-btn.google span { font-weight: 600; font-size: 14px; }
.social-btn.google:hover { background-color: #f8fcfb; border-color: #d1dcd9; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
.social-btn img { width: 20px !important; height: 20px !important; }

/* Footer */
.footer-terms { text-align: center; font-size: 10px; color: #9aa8a5; line-height: 1.5; margin-top: 25px; }
.footer-terms a { color: var(--bangladesh-green); text-decoration: none; font-weight: 600; }
.footer-terms a:hover { text-decoration: underline; }

/* =========================================
   SWEETALERT PRO DESIGN
   ========================================= */
.swal-popup-pro { border-radius: 30px !important; padding: 30px !important; box-shadow: 0 30px 70px rgba(0, 15, 1, 0.5) !important; font-family: 'Poppins', sans-serif !important; border: 1px solid rgba(255,255,255,0.1); }
.swal-title-pro { font-weight: 700; color: var(--dark-green); font-size: 24px; display: block; margin-bottom: 10px; }
.swal-text-pro { color: #6c7c79; font-size: 14px; line-height: 1.5; }
.swal-input-pro { height: 50px !important; border-radius: 15px !important; border: 2px solid #F1F7F6 !important; background-color: #F1F7F6 !important; color: var(--dark-green) !important; font-weight: 500 !important; padding: 0 20px !important; font-size: 15px !important; margin-top: 25px !important; transition: all 0.3s ease !important; box-shadow: none !important; }
.swal-input-pro:focus { border-color: var(--mountain-meadow) !important; background-color: #fff !important; box-shadow: 0 0 0 4px rgba(44, 194, 149, 0.15) !important; }
.btn-pro { border-radius: 50px !important; padding: 12px 35px !important; font-weight: 600 !important; font-size: 14px !important; text-transform: uppercase; letter-spacing: 1px; border: none !important; transition: all 0.3s ease !important; outline: none !important; min-width: 140px; }
.btn-pro-confirm { background-color: var(--dark-green) !important; color: white !important; background-image: none !important; box-shadow: 0 10px 20px rgba(3, 34, 33, 0.3) !important; }
.btn-pro-confirm:hover { background-color: var(--rich-black) !important; transform: translateY(-3px); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4) !important; }
.btn-pro-cancel { background: transparent !important; color: #889995 !important; border: 2px solid #e1e5e4 !important; box-shadow: none !important; }
.btn-pro-cancel:hover { border-color: var(--dark-green) !important; color: var(--dark-green) !important; background: #fff !important; }
.swal-actions-gap { gap: 15px !important; margin-top: 30px !important; display: flex !important; justify-content: center !important; width: 100% !important; }

/* =========================================
   REGISTRO: SPLIT SCREEN E ICONOS
   ========================================= */
.split-container { display: flex; min-height: 100vh; width: 100%; }

.brand-side { display: none; flex: 1; background-color: var(--rich-black); background-image: radial-gradient(circle at center, #062b25 0%, #000F01 80%); position: relative; flex-direction: column; justify-content: center; padding: 60px; overflow: hidden; }
.brand-content { position: relative; z-index: 2; color: #fff; }
