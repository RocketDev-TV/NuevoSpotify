<file path="frontend/src/styles/admin/analytics.css">
/* css/admin/analytics.css */

/* --- KPIS CARDS --- */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
    margin-bottom: 40px;
}

.kpi-card {
    background-color: #111;
    padding: 25px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.kpi-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 10px 30px rgba(44, 194, 149, 0.15);
}

.icon-box {
    width: 55px; height: 55px; 
    border-radius: 14px;
    display: flex; justify-content: center; align-items: center; 
    font-size: 26px; 
    margin-right: 20px;
    background: rgba(255,255,255,0.05); 
    color: #fff;
}

/* Colores por tarjeta */
.kpi-card:nth-child(1) .icon-box { background: rgba(52, 152, 219, 0.1); color: #3498db; }
.kpi-card:nth-child(2) .icon-box { background: rgba(46, 204, 113, 0.1); color: #2ecc71; }
.kpi-card:nth-child(3) .icon-box { background: rgba(155, 89, 182, 0.1); color: #9b59b6; }

.kpi-info { flex: 1; }

.kpi-header {
    display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;
}

.kpi-header h3 {
    margin: 0; font-size: 14px; color: var(--text-muted); font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;
}

.kpi-number { 
    font-size: 36px; font-weight: 700; color: #fff; line-height: 1; margin-top: 5px;
}

/* Badges (Etiquetas) */
.badge {
    font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; padding: 2px 0;
}
.badge.green { color: var(--accent); text-shadow: 0 0 10px rgba(44, 194, 149, 0.3); }
.badge.purple { color: #a29bfe; text-shadow: 0 0 10px rgba(162, 155, 254, 0.3); }

/* --- GRÁFICAS --- */
.chart-container {
    background: var(--bg-card);
    padding: 25px;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
}
.chart-container h3 { margin-top: 0; margin-bottom: 20px; font-size: 18px; }
.chart-wrapper { position: relative; height: 300px; width: 100%; }

/* --- RESPONSIVE: ANALYTICS --- */
@media (max-width: 768px) {
    .kpi-grid {
        grid-template-columns: 1fr; /* Una tarjeta por fila */
        gap: 15px;
    }

    .kpi-card {
        padding: 20px; /* Un poco menos de padding */
    }

    .kpi-number {
        font-size: 30px;
    }
    
    /* Ajuste de gráfica */
    .chart-container {
        padding: 15px;
    }
    .chart-wrapper {
        height: 250px; /* Un poco más chaparra en móvil */
    }
}
</file>

<file path="frontend/src/styles/admin/dashboard.css">
/* css/admin/dashboard.css */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

:root {
    --bg-dark: #000000;         
    --bg-sidebar: #050505;      
    --bg-card: #121212;         
    --accent: #2CC295;          
    --text-main: #FFFFFF;
    --text-muted: #B3B3B3;
    --glass-border: rgba(255, 255, 255, 0.1);
}

/* --- LAYOUT GENERAL --- */
.admin-body {
    position: fixed; 
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 100;
    padding: 0;
    background-color: var(--bg-dark);
    color: var(--text-main);
    margin: 0;
    overflow: hidden; 
    font-family: 'Poppins', sans-serif;
}

.admin-container {
    display: flex;
    height: 100vh;
    width: 100%;
}

/* --- SIDEBAR --- */
.sidebar {
    width: 260px;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    padding: 25px;
    flex-shrink: 0;
}

.logo-area h2 {
    color: var(--accent);
    margin-bottom: 40px;
    font-size: 22px;
    letter-spacing: -0.5px;
    margin-top: 0;
}

.menu {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
}

.menu-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 12px 15px;
    text-align: left;
    cursor: pointer;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
}

.menu-btn i { font-size: 20px; }

.menu-btn:hover {
    color: #fff;
    background: rgba(255,255,255,0.05);
}

.menu-btn.active {
    background: rgba(44, 194, 149, 0.15);
    color: var(--accent);
}

.logout-area {
    border-top: 1px solid var(--glass-border);
    padding-top: 20px;
}

.logout:hover { color: #e74c3c; background: rgba(231, 76, 60, 0.1); }

/* --- CONTENIDO PRINCIPAL --- */
.main-content {
    flex: 1;
    padding: 30px 40px;
    overflow-y: auto;
    background: radial-gradient(circle at top right, rgba(44,194,149,0.08), transparent 40%);
}

/* Header Superior */
.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
}

.welcome-text h1 { font-size: 28px; margin: 0; }
.welcome-text span { color: var(--accent); }
.welcome-text p { margin: 5px 0 0 0; color: var(--text-muted); font-size: 14px; }

.clock-card {
    background: rgba(255,255,255,0.05);
    padding: 8px 16px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: monospace;
    border: 1px solid var(--glass-border);
    color: var(--accent);
}

/* --- Arreglo del Modal de Álbum --- */

/* 1. Para que la fecha y el num. de canciones queden lado a lado (50% y 50%) */
.row-dates {
    display: flex;
    gap: 15px;       /* Espacio entre los dos inputs */
    margin-top: 15px; /* Separación con el input de arriba */
    width: 100%;
}

.row-dates input {
    flex: 1;         /* Esto obliga a que ambos ocupen el mismo ancho */
    width: 100%;     /* Evita desbordamientos */
    min-width: 0;    /* Truco para que Flexbox no se rompa en pantallas chicas */
}

/* 2. Estilo para el selector de Tipo de Lanzamiento para que combine */
#newAlbumType {
    width: 100%;
    padding: 12px;
    background-color: #1e1e1e; /* O el color oscuro que uses de fondo */
    color: #ffffff;
    border: 1px solid #333;
    border-radius: 8px; /* Bordes redondeados modernos */
    appearance: none;   /* Quita el estilo feo por defecto del navegador */
    margin-bottom: 5px;
}

/* 3. Ajuste general del formulario del modal */
.modal-content input, 
.modal-content select {
    margin-bottom: 15px; /* Aire entre cada fila */
}

/* --- RESPONSIVE: MÓVIL (Menú Inferior Estilo App) --- */
@media (max-width: 768px) {
    .admin-container {
        flex-direction: column;
    }

    /* 1. Sidebar se convierte en Barra Inferior */
    .sidebar {
        width: 100%;
        height: auto;
        min-height: auto;
        position: fixed;
        bottom: 0;
        left: 0;
        z-index: 1000;
        flex-direction: row;
        padding: 10px;
        border-right: none;
        border-top: 1px solid var(--glass-border);
        justify-content: space-between;
        align-items: center;
        background: rgba(5, 5, 5, 0.95); /* Fondo sólido para que no se trasluzca feo */
        backdrop-filter: blur(10px);
    }

    /* 2. Ocultar Logo en móvil para ahorrar espacio */
    .logo-area {
        display: none;
    }

    /* 3. Ajustar el menú para que sea horizontal */
    .menu {
        flex-direction: row;
        justify-content: space-around;
        width: 100%;
        gap: 0;
    }

    .menu-btn {
        flex-direction: column; /* Ícono arriba, texto abajo */
        gap: 4px;
        font-size: 10px;
        padding: 5px;
        text-align: center;
        justify-content: center;
        border-radius: 0;
        background: transparent !important; /* Quitar fondo gris */
    }

    .menu-btn i {
        font-size: 22px;
        margin: 0;
    }
    
    .menu-btn.active {
        color: var(--accent); /* Solo pintar el ícono/texto */
    }

    /* 4. Botón de Salir (Lo hacemos chiquito a la derecha o lo ocultamos si prefieres) */
    .logout-area {
        padding: 0;
        border: none;
        margin-left: 5px;
    }
    .logout-area .menu-btn {
        padding: 5px;
        color: #e74c3c;
    }

    /* 5. Ajustar el contenido principal para que no lo tape la barra */
    .main-content {
        padding: 20px;
        padding-bottom: 90px; /* ESPACIO EXTRA PARA LA BARRA INFERIOR */
        width: 100%;
    }

    /* 6. Header Superior (Hola Admin) */
    .top-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 25px;
    }
    .clock-card {
        align-self: flex-end; /* Reloj a la derecha */
        font-size: 12px;
    }
    
    /* Ajustes Modal en Móvil */
    .modal-content {
        width: 90%;
        margin: 0 5%;
        padding: 20px;
        max-height: 85vh; /* Que no sea más alto que la pantalla */
        overflow-y: auto; /* Scroll si es muy largo */
    }
    .row-dates {
        grid-template-columns: 1fr; /* Fechas una abajo de otra */
    }
}
