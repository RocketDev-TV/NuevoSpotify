export const state = {
    genreId: null,
    artistId: null,
    albumId: null,
    isContextLocked: false, // Bandera de seguridad
    stagedFiles: []
};

// --- LOGICA DE CARGA DE COMBOS ---
export async function handleGenreChange(e) {
